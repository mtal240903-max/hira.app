# Serveur
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/hira

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS - domaines autorisés (séparés par des virgules)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:19006

# Stockage média - S3-compatible (MinIO en dev)
# Avec docker-compose.yml fourni, ces valeurs fonctionnent telles quelles en local
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hira-media
S3_ACCESS_KEY=hira_admin
S3_SECRET_KEY=hira_secret_key

# En production (AWS S3 par ex.) :
# S3_ENDPOINT=            (laisser vide, AWS SDK résout l'endpoint automatiquement)
# S3_PUBLIC_URL=https://hira-media.s3.amazonaws.com
# S3_REGION=eu-west-3
# S3_ACCESS_KEY=<clé IAM>
# S3_SECRET_KEY=<secret IAM>

# Notifications push - Firebase Cloud Messaging
# JSON du compte de service Firebase, encodé en base64 :
# cat service-account.json | base64 -w 0
FIREBASE_SERVICE_ACCOUNT=

# Intégration Wuro'en (connexion via compte Wuro'en existant, écosystème MTAL)
# URL de base de l'API Wuro'en (sans /api à la fin, déjà inclus dans WUROEN_ME_ENDPOINT)
WUROEN_API_URL=https://wuroen-app.onrender.com
# Route qui retourne le profil de l'utilisateur à partir d'un token Bearer
WUROEN_ME_ENDPOINT=/api/auth/me
